<Window x:Class="SinTachiePlugin.Window_Stp.PartValueTemplateEditor.AskNameOfNewTemplateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SinTachiePlugin.Window_Stp.PartValueTemplateEditor"
        xmlns:resx="clr-namespace:SinTachiePlugin.Properties"
        mc:Ignorable="d"
        Title="{x:Static resx:TextResource.AskNameOfNewTemplateDialog_Title}" Width="200">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0"
              Margin="4">
            <ComboBox Name="TemplateNameComboBox"
                      IsEditable="True"
                      KeyDown="TemplateNameComboBox_KeyDown"
                      Loaded="TemplateNameComboBox_Loaded"/>
            <TextBlock Text="{x:Static resx:TextResource.AskNameOfNewTemplateDialog_TemplateName}"
                       Name="PlaceHolder"
                       Margin="5,0"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       Opacity="0.5"/>
        </Grid>
        <Button Grid.Row="1"
                Name="CommitButton"
                Content="OK"
                HorizontalAlignment="Right"
                Width="64"
                Click="CommitButton_Click"/>
    </Grid>
</Window>
