<UserControl x:Class="SinTachiePlugin.Control.PartAnimationValueList.PartAnimationValueViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SinTachiePlugin.Control.PartAnimationValueList"
             xmlns:local2="clr-namespace:SinTachiePlugin.PartAnimation"
             xmlns:local3="clr-namespace:SinTachiePlugin.Enums"
             xmlns:resx="clr-namespace:SinTachiePlugin.Properties"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=local2:PartAnimationValue}">
    <Grid Margin="2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Path x:Name="SelectedSign"
                  Visibility="Hidden"
                  VerticalAlignment="Center"
                  Fill="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                  Data="M2,30 L2,0 L15,15 Z"/>
        </Grid>
        <Border Grid.Column="1"
                VerticalAlignment="Center"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="2">
            <Grid Margin="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0"
                            Margin="2,0"
                            Orientation="Horizontal">
                    <TextBlock Text="{x:Static resx:TextResource.PartAnimationValueVeiwer_AnimationTag}"
                               FontWeight="Bold"
                            VerticalAlignment="Center"/>

                    <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                            BorderThickness="1"
                            Padding="2,0"
                            Margin="2,0,0,0"
                            HorizontalAlignment="Left">
                        <TextBlock Text="{Binding AnimationTag}"/>
                    </Border>
                </StackPanel>
                <Separator Grid.Row="1"
                           BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                           BorderThickness="1"
                           Margin="0,2"/>
                <StackPanel Grid.Row="2"
                            Margin="2,0"
                            Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static resx:TextResource.PartAnimationValueVeiwer_Index}"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <Border Margin="2,0,0,0"
                                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                BorderThickness="1"
                                Padding="2,0">
                            <TextBlock Text="{Binding Index}"/>
                        </Border>
                    </StackPanel>
                    <Rectangle Margin="4,0"
                               Width="1"
                               Fill="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                               VerticalAlignment="Stretch"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static resx:TextResource.PartAnimationValueVeiwer_AnmOpeMode}"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <Border Margin="2,0,0,0"
                                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                BorderThickness="1"
                                Padding="2,0">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Error!"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AnmOpeMode}" Value="{x:Static local3:PartAnimationOpeMode.Simple}">
                                                <Setter Property="Text" Value="{x:Static resx:TextResource.PartAnimationOpeMode_Simple}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding AnmOpeMode}" Value="{x:Static local3:PartAnimationOpeMode.Sum}">
                                                <Setter Property="Text" Value="{x:Static resx:TextResource.PartAnimationOpeMode_Sum}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding AnmOpeMode}" Value="{x:Static local3:PartAnimationOpeMode.Product}">
                                                <Setter Property="Text" Value="{x:Static resx:TextResource.PartAnimationOpeMode_Product}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding AnmOpeMode}" Value="{x:Static local3:PartAnimationOpeMode.Sin}">
                                                <Setter Property="Text" Value="{x:Static resx:TextResource.PartAnimationOpeMode_Sin}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding AnmOpeMode}" Value="{x:Static local3:PartAnimationOpeMode.VoiceVolume}">
                                                <Setter Property="Text" Value="{x:Static resx:TextResource.PartAnimationOpeMode_VoiceVolume}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding AnmOpeMode}" Value="{x:Static local3:PartAnimationOpeMode.VoiceVolumePlus}">
                                                <Setter Property="Text" Value="{x:Static resx:TextResource.PartAnimationOpeMode_VoiceVolumePlus}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding AnmOpeMode}" Value="{x:Static local3:PartAnimationOpeMode.PeriodicShuttle}">
                                                <Setter Property="Text" Value="{x:Static resx:TextResource.PartAnimationOpeMode_PeriodicShuttle}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding AnmOpeMode}" Value="{x:Static local3:PartAnimationOpeMode.PeriodicLoop}">
                                                <Setter Property="Text" Value="{x:Static resx:TextResource.PartAnimationOpeMode_PeriodicLoop}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding AnmOpeMode}" Value="{x:Static local3:PartAnimationOpeMode.AudioFile}">
                                                <Setter Property="Text" Value="{x:Static resx:TextResource.PartAnimationOpeMode_AudioFile}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>

                </StackPanel>
                <Separator Grid.Row="3"
                           BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                           BorderThickness="1"
                           Margin="0,2"/>
                <StackPanel Grid.Row="4"
                            Margin="2,0">
                    <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                            BorderThickness="1"
                            Padding="2,0"
                            HorizontalAlignment="Left">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AnmOpeMode}" Value="{x:Static local3:PartAnimationOpeMode.Simple}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding AnmOpeArgments.Abrir.Values[0].Value,StringFormat={}{0:F1}%}"/>
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AnmOpeMode}" Value="{x:Static local3:PartAnimationOpeMode.Sum}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                BorderThickness="1"
                                Padding="2,0"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{Binding AnmOpeArgments.Abrir.Values[0].Value,StringFormat={}{0:F1}%}"/>
                        </Border>
                        <TextBlock Text="+"
                                   FontWeight="Bold"
                                   Margin="2,0"
                                   VerticalAlignment="Center"/>
                        <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                BorderThickness="1"
                                Padding="2,0"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{Binding AnmOpeArgments.Cerrar.Values[0].Value,StringFormat={}{0:F1}%}"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AnmOpeMode}" Value="{x:Static local3:PartAnimationOpeMode.Product}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                BorderThickness="1"
                                Padding="2,0"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{Binding AnmOpeArgments.Abrir.Values[0].Value,StringFormat={}{0:F1}%}"/>
                        </Border>
                        <TextBlock Text="×"
                                   FontWeight="Bold"
                                   Margin="2,0"
                                   VerticalAlignment="Center"/>
                        <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                BorderThickness="1"
                                Padding="2,0"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{Binding AnmOpeArgments.Cerrar.Values[0].Value,StringFormat={}{0:F1}%}"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AnmOpeMode}" Value="{x:Static local3:PartAnimationOpeMode.Sin}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                BorderThickness="1"
                                Padding="2,0"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{Binding AnmOpeArgments.Abrir.Values[0].Value,StringFormat={}{0:F1}%}"/>
                        </Border>
                        <TextBlock Text="+"
                                   FontWeight="Bold"
                                   Margin="2,0"
                                   VerticalAlignment="Center"/>
                        <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                BorderThickness="1"
                                Padding="2,0"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{Binding AnmOpeArgments.Cerrar.Values[0].Value,StringFormat={}{0:F1}%}"/>
                        </Border>
                        <TextBlock Text="×sin("
                                   FontWeight="Bold"
                                   Margin="2,0"
                                   VerticalAlignment="Center"/>
                        <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                BorderThickness="1"
                                Padding="2,0"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{Binding AnmOpeArgments.Theta.Values[0].Value,StringFormat={}{0:F1}°}"/>
                        </Border>
                        <TextBlock Text=")"
                                   FontWeight="Bold"
                                   Margin="2,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AnmOpeMode}" Value="{x:Static local3:PartAnimationOpeMode.VoiceVolume}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{x:Static resx:TextResource.PartAnimationValueVeiwer_Open}"
                                   FontWeight="Bold"
                                   Margin="0,0,4,0"
                                   VerticalAlignment="Center"/>
                        <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                BorderThickness="1"
                                Padding="2,0"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{Binding AnmOpeArgments.Abrir.Values[0].Value,StringFormat={}{0:F1}%}"/>
                        </Border>
                        <Rectangle Margin="4,0"
                                   Width="1"
                                   Fill="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                   VerticalAlignment="Stretch"/>
                        <TextBlock Text="{x:Static resx:TextResource.PartAnimationValueVeiwer_Close}"
                                   FontWeight="Bold"
                                   Margin="0,0,4,0"
                                   VerticalAlignment="Center"/>
                        <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                BorderThickness="1"
                                Padding="2,0"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{Binding AnmOpeArgments.Cerrar.Values[0].Value,StringFormat={}{0:F1}%}"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AnmOpeMode}" Value="{x:Static local3:PartAnimationOpeMode.VoiceVolumePlus}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{x:Static resx:TextResource.PartAnimationValueVeiwer_Open}"
                                   FontWeight="Bold"
                                   Margin="0,0,4,0"
                                   VerticalAlignment="Center"/>
                        <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                BorderThickness="1"
                                Padding="2,0"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{Binding AnmOpeArgments.Abrir.Values[0].Value,StringFormat={}{0:F1}%}"/>
                        </Border>
                        <Rectangle Margin="4,0"
                                   Width="1"
                                   Fill="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                   VerticalAlignment="Stretch"/>
                        <TextBlock Text="{x:Static resx:TextResource.PartAnimationValueVeiwer_Close}"
                                   FontWeight="Bold"
                                   Margin="0,0,4,0"
                                   VerticalAlignment="Center"/>
                        <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                BorderThickness="1"
                                Padding="2,0"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{Binding AnmOpeArgments.Cerrar.Values[0].Value,StringFormat={}{0:F1}%}"/>
                        </Border>
                        <Rectangle Margin="4,0"
                                   Width="1"
                                   Fill="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                   VerticalAlignment="Stretch"/>
                        <TextBlock Text="{x:Static resx:TextResource.PartAnimationValueVeiwer_Silent}"
                                   FontWeight="Bold"
                                   Margin="0,0,4,0"
                                   VerticalAlignment="Center"/>
                        <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                BorderThickness="1"
                                Padding="2,0"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{Binding AnmOpeArgments.Silent.Values[0].Value,StringFormat={}{0:F1}%}"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AnmOpeMode}" Value="{x:Static local3:PartAnimationOpeMode.PeriodicShuttle}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding AnmOpeMode}" Value="{x:Static local3:PartAnimationOpeMode.PeriodicLoop}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding AnmOpeMode}" Value="{x:Static local3:PartAnimationOpeMode.AudioFile}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{x:Static resx:TextResource.PartAnimationValueVeiwer_A}"
                                   FontWeight="Bold"
                                   Margin="0,0,4,0"
                                   VerticalAlignment="Center"/>
                        <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                BorderThickness="1"
                                Padding="2,0"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{Binding AnmOpeArgments.Abrir.Values[0].Value,StringFormat={}{0:F1}%}"/>
                        </Border>
                        <Rectangle Margin="4,0"
                                   Width="1"
                                   Fill="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                   VerticalAlignment="Stretch"/>
                        <TextBlock Text="{x:Static resx:TextResource.PartAnimationValueVeiwer_B}"
                                   FontWeight="Bold"
                                   Margin="0,0,4,0"
                                   VerticalAlignment="Center"/>
                        <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                BorderThickness="1"
                                Padding="2,0"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{Binding AnmOpeArgments.Cerrar.Values[0].Value,StringFormat={}{0:F1}%}"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="5">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Comment}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Separator BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                               BorderThickness="1"
                               Margin="0,2"/>
                    <StackPanel Margin="2,0"
                                Orientation="Horizontal">
                        <TextBlock Text="{x:Static resx:TextResource.PartAnimationValueVeiwer_Comment}"
                                   FontWeight="Bold" TextWrapping="Wrap"/>
                        <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                BorderThickness="1"
                                Padding="2,0"
                                Margin="4,0,0,0"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Comment}"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
